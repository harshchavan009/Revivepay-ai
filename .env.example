# ==============================================================================
# RevivePay AI — Production & Sandbox Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure real credentials for deployment.
# NEVER commit real production API keys or credentials to source control.

# Application General
PROJECT_NAME="RevivePay AI"
ENVIRONMENT="sandbox" # Options: sandbox | production
ENVIRONMENT_LABEL="Sandbox Environment — Razorpay Test Mode"
PUBLIC_APP_URL="https://demo.revivepay.ai"

# Database Configuration (PostgreSQL in production; SQLite in local dev)
# Example PostgreSQL: postgresql://postgres:your_password@db.example.com:5432/revivepay
DATABASE_URL="sqlite:///./revivepay.db"

# Session Security & Cryptography
# Generate a strong 256-bit secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
CSRF_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# High-Value Governance Policy (INR)
HIGH_VALUE_THRESHOLD=50000.0

# Rate Limiting Controls
RATE_LIMIT_AUTH_PER_MINUTE=15
RATE_LIMIT_WEBHOOK_PER_MINUTE=120

# Razorpay Integration (Test or Live Mode)
# In Test mode: keys start with rzp_test_
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Multi-Tier AI Provider Keys (Sequential Fallback)
# 1. Primary: Anthropic Claude 3.5 Sonnet
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 2. Fallback: Google Gemini 1.5 Pro
GEMINI_API_KEY=
LLM_MODEL=gemini-1.5-pro

# 3. Safe Fallback Floor: Deterministic Rules Engine (Enabled automatically if no LLM keys are supplied)
